# Dirección donde escucha el servidor.
MULTIPARTY_ADDR=:8080
# Ruta del archivo SQLite.
MULTIPARTY_DB=data/multiparty.db
# Clave para firmar las cookies de sesión (32+ caracteres aleatorios).
# Si falta, se genera una al arrancar y las sesiones se pierden al reiniciar.
MULTIPARTY_SECRET=
# País de la tienda de Apple Music para buscar canciones (ISO 3166-1).
MULTIPARTY_PAIS=MX

# --- Cuentas de YouTube Music y Spotify (opcionales) ---
# URL pública del sitio; debe coincidir con los URI de redirección.
# Spotify no acepta "localhost": en tu máquina usa 127.0.0.1.
MULTIPARTY_BASE_URL=http://127.0.0.1:8080

# YouTube Music (fase F2). Ver docs/GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Spotify (fase F3). Ver docs/SPOTIFY.md
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Cifra los tokens OAuth guardados (openssl rand -base64 32). No la cambies.
MULTIPARTY_CLAVE_TOKENS=
